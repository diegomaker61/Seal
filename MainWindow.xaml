<Window x:Class="Seal.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindowStyle}" Title="Seal" Width="350" Height="175" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#454545" BorderThickness="1" CornerRadius="8" Padding="16" MouseLeftButtonDown="DragWindow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="CloseWindow" ToolTip="Close" Padding="8,2" AutomationProperties.Name="Close" Width="35">
                    <Path Style="{StaticResource MaterialIconStyle}" Data="{StaticResource MaterialClose}" Width="12" Height="12"/>
                </Button>
                <Button DockPanel.Dock="Right" Click="OpenStatistics" Padding="8,2" ToolTip="Statistics" AutomationProperties.Name="Statistics" Width="35" Height="24">
                    <Path Style="{StaticResource MaterialIconStyle}" Data="{StaticResource MaterialStatistics}" Width="12" Height="12"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <TextBlock Text="Seal" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TimeDisplay" Text="30:00" FontSize="36" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusDisplay" Text="Ready to focus" Foreground="#AAAAAA" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleButton" Click="ToggleTimer" Background="{StaticResource AccentBrush}" ToolTip="Play" AutomationProperties.Name="Play" Width="40">
                    <Path x:Name="ToggleIcon" Style="{StaticResource MaterialIconStyle}" Data="{StaticResource MaterialPlay}" RenderTransformOrigin="0.5,0.5" Width="12" Height="12">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button Click="ResetTimer" ToolTip="Reset session" AutomationProperties.Name="Reset" Width="40">
                    <Path Style="{StaticResource MaterialIconStyle}" Data="{StaticResource MaterialReset}" Width="12"/>
                </Button>
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="FocusProgress" Grid.Row="2" Height="5" Maximum="100" Background="#383838" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
