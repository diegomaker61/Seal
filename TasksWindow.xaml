<Window x:Class="Seal.TasksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindowStyle}" Title="Seal — Tasks" Width="400" Height="480" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#454545" BorderThickness="1" CornerRadius="8" Padding="20" MouseLeftButtonDown="DragWindow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Click="CloseWindow" ToolTip="Close" AutomationProperties.Name="Close" Width="32" Padding="0">
                    <Path Style="{StaticResource MaterialIconStyle}" Data="{StaticResource MaterialClose}" Width="12" Height="12"/>
                </Button>
                <TextBlock Text="Tasks" FontSize="24" FontWeight="SemiBold"/>
            </DockPanel>
            <ListBox x:Name="TaskList" Grid.Row="1" ItemTemplate="{StaticResource TaskNameTemplate}" SelectionChanged="SelectTask" Background="{StaticResource SurfaceBrush}" Foreground="#F5F5F5" BorderThickness="0" Padding="4"/>
            <StackPanel Grid.Row="2" Margin="0,12,0,12">
                <TextBlock Text="Task Name" Margin="0,0,0,8"/>
                <TextBox x:Name="TaskNameInput" MaxLength="15" ToolTip="Task name (up to 15 characters)" AutomationProperties.Name="Task Name"/>
            </StackPanel>
            <StackPanel Grid.Row="3">
                <TextBlock Text="Daily goal" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,12">
                    <ComboBox x:Name="TargetInput" IsEditable="False" Height="30" AutomationProperties.Name="Daily goal in hours">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat={}{0}h}" Foreground="#FFFFFF"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Content="Save" Click="SaveTask" Background="{StaticResource AccentBrush}"/>
                <Button x:Name="NewButton" Content="New" Click="NewTask"/>
                <Button x:Name="RemoveButton" Content="Remove" Click="RemoveTask"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="FeedbackLabel" Grid.Row="4" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,12,0,0" Text="Keep at least one task. Add another to remove default."/>
        </Grid>
    </Border>
</Window>
