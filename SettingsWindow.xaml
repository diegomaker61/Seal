<Window x:Class="Seal.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindowStyle}" Title="Seal — Settings" Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#454545" BorderThickness="1" CornerRadius="8" Padding="20" MouseLeftButtonDown="DragWindow">
        <StackPanel>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Click="CloseWindow" ToolTip="Close" Width="32" Height="28" Padding="0">
                    <Path Style="{StaticResource MaterialIconStyle}" Data="{StaticResource MaterialClose}" Width="12" Height="12"/>
                </Button>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Text="Global shortcut" Margin="0,0,0,6"/>
            <TextBox x:Name="ShortcutInput" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" ToolTip="Click here and press your shortcut"/>
            <TextBlock Text="Click the field and press Ctrl/Alt/Windows + a key." FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <CheckBox x:Name="BorderOption" Content="Show focus border on all monitors" Foreground="#FFFFFF" Margin="0,0,0,12"/>
            <CheckBox x:Name="StartupOption" Content="Start with Windows" Foreground="#FFFFFF" Margin="0,0,0,20"/>
            <TextBlock Text="Focus duration (10–60 minutes)" Margin="0,0,0,6"/>
            <ComboBox x:Name="DurationInput" Height="30" IsEditable="False" AutomationProperties.Name="Focus duration in minutes">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FFFFFF"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Duration changes apply to the next session." FontSize="11" Foreground="#AAAAAA" Margin="0,6,0,16"/>
            <TextBlock x:Name="FeedbackLabel" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CloseWindow"/>
                <Button Content="Save" Click="SaveSettings" Background="{StaticResource AccentBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
